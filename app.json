{
  "expo": {
    "name": "Capsule",
    "slug": "closet-os",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Capsule uses your camera to photograph clothing items to add them to your wardrobe.",
          "photosPermission": "Capsule accesses your photo library so you can add existing photos of clothing items.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2E9DA"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "buildNumber": "8",
      "infoPlist": {
        "NSCameraUsageDescription": "Capsule uses your camera to photograph clothing items to add them to your wardrobe.",
        "NSPhotoLibraryUsageDescription": "Capsule accesses your photo library so you can add existing photos of clothing items.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.gabe822.closetos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4679B7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ],
      "package": "com.gabe822.closetos",
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7d6926cc-7a17-4429-a209-f6bbc768e13c"
      }
    },
    "owner": "gabe822",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7d6926cc-7a17-4429-a209-f6bbc768e13c",
      "fallbackToCacheTimeout": 8000
    }
  }
}
