# Supabase project the app talks to.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat PUBLIC iOS SDK key (starts "appl_"). Safe to ship in the binary —
# it can only read offerings and start purchases. The SECRET key never goes
# here; it lives in Supabase function secrets, where the phone cannot reach it.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
